        while (fgets(line, sizeof(line), file))
		{
			float x0, x1, y0, y1;
			if (sscanf(line, "-%f-%f", &backgroundImageToSpriteYScaleFactor, &backgroundImageToSpriteXScaleFactor) == 2)
			{
				fprintf(logFile, "YScaleFactor: %f\n",backgroundImageToSpriteYScaleFactor);
				fflush(logFile);
				fprintf(logFile, "XScaleFactor: %f\n",backgroundImageToSpriteXScaleFactor);
				fflush(logFile);
			}
			else if (sscanf(line, "%f,%f,%f,%f", &x0, &x1, &y0, &y1) == 4)
			{
				Object* groundTemp = malloc(sizeof(Object));
				*groundTemp = createGround((x0*backgroundImageToSpriteXScaleFactor)-backgroundPositionX,(x1*backgroundImageToSpriteXScaleFactor)-backgroundPositionX,
				((1679-y0)*backgroundImageToSpriteYScaleFactor)-1950,
				((1679-y1)*backgroundImageToSpriteYScaleFactor)-1950);
				grounds[lineNumber] = groundTemp;
				lineNumber++;
			}
		}
        fclose(file);
    }
    else
	{
        // Print an error message to the standard error
        // stream if the file cannot be opened.
        fprintf(logFile, "Unable to open file!\n");
		fflush(logFile);
    }
	
	initialiseTimer();
		
	fprintf(logFile,"Opening window...\n");
	fflush(logFile);
	
    os_error *err = xwimp_open_window(&block.open);
    if (err != NULL)
    {
        fprintf(logFile, "msg = '%s'\n", err->errmess);
        fflush(logFile);
    }
	
    while(!quit)
    {
		event = wimp_poll(0,&block,NULL);
		if (event == wimp_NULL_REASON_CODE)
		{
			updateTimer(&block);
		}
		else
		{
			quit = update(event,&block);
		}
    }
	
	for(int i=0;i<numEnemies;i++)
		free(enemies[i]);
	
	for(int i=0;i<numGrounds;i++)
		free(grounds[i]);
	
    free(window);
    wimp_close_down(0);
	free(player);
	free(area);
    fclose(logFile);
    return 0;
}