//===================================================================================
//FUNCTION - loadSpriteFile

//PARAMETERS:
//filename - The file name
//imageNames - List of names which will also set the order that the sprites are in the sprite array
//imagesSize - Size of the array so we don't go out of bounds

//DESCRIPTION:
// This function loads sprites from a file and generates a translation table the sprite array

// RETURN: void
//===================================================================================
void loadSpriteFile(const char *filename,const char *imageNames[],const int imagesSize)
{
   int size;

   bits type;
   
   fprintf(logFile, "loading sprites...\n"); 
   fflush(logFile);

   fileswitch_object_type objType;
   
   os_error *e = xosfile_read_stamped_no_path(filename, &objType, NULL, NULL, &size, NULL, &type);
   
   if (e != NULL)
   {
      fprintf(logFile, "Failed Getting Size\n"
         "   errnum = %d: message = '%s'\n", e->errnum, e->errmess);
      fflush(logFile);
   }
   fprintf(logFile, "sprite file size = %d\n", size);
   fflush(logFile);

   size += sizeof(int);
   
   area = malloc(size);

   area->size  = size;
   area->first = 16;

	//Load sprite file
	e = xosspriteop_load_sprite_file(osspriteop_USER_AREA, area, filename);
	
   if (e != NULL)
   {
	  free(area);
      fprintf(logFile, "Failed Loading SpriteFile\n"
         "   errnum = %d: message = '%s'\n", e->errnum, e->errmess);
      fflush(logFile);
   }
   for(int i = 0; i < imagesSize ; i++)
   {
	   // determine more efficient sprite pointer ids                               
		e = xosspriteop_select_sprite(osspriteop_USER_AREA, 
								area, 
                               (osspriteop_id)imageNames[i],
                               &sprites[i]);
		if (e != NULL)
		{
			free(area);
			fprintf(logFile, "selecting %s failed\n"
				"   errnum = %d: message = '%s'\n",imageNames[i], e->errnum, e->errmess);
			fflush(logFile);
		}
   }
   
   factors.xmul = 4<<(modeInfo.info.xEigFactor-1);
   factors.ymul = 2<<(modeInfo.info.yEigFactor);
   factors.xdiv = 1;
   factors.ydiv = 1;
   
   Backgroundfactors.xmul = 1<<(modeInfo.info.xEigFactor-1);
   Backgroundfactors.ymul = 1<<(modeInfo.info.yEigFactor);
   Backgroundfactors.xdiv = 1;
   Backgroundfactors.ydiv = 1;
   
   e = xcolourtrans_generate_table_for_sprite(area,  
				(osspriteop_id)imageNames[0],
                (os_mode)-1,   
                (os_palette*)-1,    
                NULL,
                colourtrans_RETURN_WIDE_ENTRIES,
                NULL,
                NULL,
                &size);
   if (e != NULL)
   {
      fprintf(logFile, "xcolourtrans_generate_table #1 failed\n"
         "   errnum = %d: message = '%s'\n", e->errnum, e->errmess);
      fflush(logFile);
   }

   fprintf(logFile, "colourtrans table size = %d\n", size);
   fflush(logFile);
   
   transTab = malloc(size);

   e = xcolourtrans_generate_table_for_sprite(area, 
                (osspriteop_id)imageNames[0],
                (os_mode)-1,   
                (os_palette*)-1,   
                transTab,
                colourtrans_RETURN_WIDE_ENTRIES,
                NULL,
                NULL,
                &size);
   if (e != NULL)
   {
      fprintf(logFile, "xcolourtrans_generate_table #2 failed\n"
         "   errnum = %d: message = '%s'\n", e->errnum, e->errmess);
      fflush(logFile);
   }   
   // all done
   fprintf(logFile, "finished loading sprites\n");
   fflush(logFile);
}

//===================================================================================
//FUNCTION - getPlayerState

//PARAMETERS:
//player - character that is controlled by the user

//DESCRIPTION:
// This is the animation for the player, handling direction and collidion states to
// choose the right animation

// RETURN:
// result: The state position in the sprite array
//===================================================================================
int getPlayerState(Player* player)
{
	enum checks
	{
		GROUNDED = 1<<0,
		MOVING = 1<<1,
		ATTACKING = 1<<2,
		CROUCHING = 1<<3
	};
	int directionAddon = player->parent.direction == 1 ? (numSprites-numberOfBackgrounds)/2 : 0;
	
	// Climbing takes priority
	if (player->isClimbing)
	{
		// Only move frames if the player is moving
		if ((keyState & KEY_DOWN || keyState & KEY_UP))
			player->parent.frame++;
		
		int result = 10 + (player->parent.frame % (4*ANIMATIONFPSCOUNTERMULTIPLY) ) / (2*ANIMATIONFPSCOUNTERMULTIPLY);
		return result + directionAddon;
	}
	
	//Movement if not climbing
	int stateNumber;
	stateNumber = player->isGrounded == TRUE ? GROUNDED : 0;
	stateNumber = player->parent.dx > 0 ? stateNumber + MOVING : stateNumber;
	stateNumber = player->isAttacking == TRUE ? stateNumber + ATTACKING : stateNumber;
	stateNumber = player->isCrouching == TRUE ? stateNumber + CROUCHING : stateNumber;
	
	switch(stateNumber)
	{
		case GROUNDED:
		{
			player->parent.frame = 0;
			return directionAddon;
		}
		case GROUNDED + CROUCHING:
		{
			int result = (player->parent.frame < 2) ? 8 : 9;
			player->parent.frame++;
			return result + directionAddon;
		}
		case GROUNDED + CROUCHING + MOVING:
		case GROUNDED + MOVING:
		{
			int result = 1 + (player->parent.frame % (16*ANIMATIONFPSCOUNTERMULTIPLY))/(4*ANIMATIONFPSCOUNTERMULTIPLY);
			player->parent.frame++;
			return result + directionAddon;
		}
		case GROUNDED + ATTACKING:
		case GROUNDED + ATTACKING + MOVING:
		{
			player->parent.frame = 7 + directionAddon;
			return 7 + directionAddon;
		}
		case ATTACKING:
		case ATTACKING + MOVING:
		{
			player->parent.frame = 6 + directionAddon;
			return 6 + directionAddon;
		}
		default:
		return 5 + directionAddon;
	}
	return directionAddon;
}


//===================================================================================
//FUNCTION - getEnemyState

//PARAMETERS:
//enemy - current enemy that is being updated

//DESCRIPTION:
// This fuction set the correct animation for an enemy

// RETURN:
// result: The state position in the sprite array
//===================================================================================
int getEnemyState(Enemy* enemy)
{
	int directionAddon = enemy->parent.direction == 1 ? (numSprites-numberOfBackgrounds)/2 : 0;
	switch (enemy->parent.id)
	{
		case MONKEY:
		{
			if(enemy->parent.isDead)
			{
				return MONKEY + 2 + directionAddon;
			}
			int result = MONKEY + (enemy->parent.frame % (8*ANIMATIONFPSCOUNTERMULTIPLY))/(4*ANIMATIONFPSCOUNTERMULTIPLY);
			enemy->parent.frame++;
			return result + directionAddon;
		}
		case BEE:
		{
			int result = BEE + (enemy->parent.frame % 4)/2;
			enemy->parent.frame++;
			return result + directionAddon;
		}
	}
	return enemy->parent.id;
}


//===================================================================================
//FUNCTION - update

//PARAMETERS:
//event - Event recived from and got from the poll
//block - The current block that sent the event

//DESCRIPTION:
// This function handles the events recieved by the poll request

// RETURN:
// result: This is set when the plater wants to quit
//===================================================================================
osbool update(wimp_event_no event,wimp_block* block)
{
    switch(event)
    {
		case wimp_REDRAW_WINDOW_REQUEST:
		{
			redrawWindow(block);
			break;
		}
		case wimp_OPEN_WINDOW_REQUEST:
		{
			wimp_open_window(&block->open);
			break;
		}
		case wimp_CLOSE_WINDOW_REQUEST:
		{
			wimp_close_window(block->close.w);
			return TRUE;
		}
		case wimp_USER_MESSAGE:
		{
			break;
		}
		case wimp_USER_MESSAGE_RECORDED:
		{
			if(block->message.action == message_QUIT)
			{
				return TRUE;
			}
			break;
		}
	}
	return FALSE;
}


