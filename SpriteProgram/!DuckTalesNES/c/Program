//Objects==========================================================================
Player createPlayer(int x, int y)
{
	Player player;
	player.parent.x = x;
	player.parent.y = y;
	player.parent.dx = 0;
	player.parent.dy = 0;
	player.parent.id = PLAYER;
	player.parent.frame = 0;
	player.isGrounded = TRUE;
	player.isAttacking = FALSE;
	player.parent.isDead = FALSE;
	//-1 is left, 1 is right
	player.parent.direction = -1;
	player.parent.currentSprite = sprites[0];
	player.parent.width = 200;
	player.parent.height = 250;
	
	return player;
}
Enemy createEnemy(objectTypes type,int x, int y)
{
	Enemy enemy;
	enemy.parent.x = x;
	enemy.parent.y = y;
	enemy.parent.dx = 0;
	enemy.parent.dy = 0;
	enemy.parent.id = type;
	enemy.parent.frame = 0;
	enemy.parent.isDead = FALSE;
	//-1 is left, 1 is right
	enemy.parent.direction = -1;
	enemy.parent.currentSprite = sprites[type];
	if(type == MONKEY)
	{
		enemy.parent.width = 225;
		enemy.parent.height = 250;
	}
	return enemy;
}

Object createObject(int x1,int x2,int y1,int y2,objectTypes type)
{
	Object obj;
	obj.x = x1;
	obj.y = y1;
	obj.id = type;
	obj.width = x2-x1;
	obj.height = y2-y1;
	return obj;
}
