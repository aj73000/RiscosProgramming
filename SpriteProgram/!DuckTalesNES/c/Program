//===================================================================================
//FUNCTION - isOnScreen

//PARAMETERS:
//x - X position of point
//y - Y position of point 

//DESCRIPTION:
// This function checks if a point is on the screen

// RETURN: int (1 or 0)
//===================================================================================
int isOnScreen(int x, int y) 
{
    return (x >= player->parent.x-(screenWidth/2) &&
            x <= player->parent.x+(screenWidth/2) &&
            y >= player->parent.y - screenHeight &&
            y <= player->parent.y + screenHeight);
}

//===================================================================================
//FUNCTION - collisionDetection

//PARAMETERS:
//object1 - The object colliding
//object2 - The object object1 is colliding with

//DESCRIPTION:
// This function uses AABB-AABB collision detection to determin if two objects are colliding

// RETURN: void
//===================================================================================
void collisionDetection(Object* object1, Object* object2)
{
    if(object1->x <= object2->x + object2->width &&
       object1->x + object1->width >= object2->x &&
       object1->y <= object2->y + object2->height &&
       object1->y + object1->height >= object2->y)
    {
        collisionResponse(object1, object2);
    }
}

//===================================================================================
//FUNCTION - collisionResponse

//PARAMETERS:
//object1 - The object colliding
//object2 - The object object1 is colliding with

//DESCRIPTION:
// This function resolves the collision of certain collision types and does certain effects based on
// the objects and there stats

// RETURN: void
//===================================================================================
void collisionResponse(Object* object1, Object* object2)
{
    switch(object2->id)
    {
		case BEE:
        case MONKEY:
        {
            if(object1->id == PLAYER)
            {
                Player* player = (Player*)object1;
                
                if(player->isAttacking)
                {
                    if(!object2->isDead)
                    {
                        object2->isDead = TRUE;
                        object2->dy = 20;
                    }
                }
                else
                {
                    player->parent.isDead = TRUE;
                }
            }       
            break;
        }
		case GROUND:
        case SPIKES:
        {
            float object1Left = object1->x;
            float object1Right = object1->x + object1->width;
            float object1Bottom = object1->y;
            float object1Top = object1->y + object1->height;

            float object2Left = object2->x;
            float object2Right = object2->x + object2->width;
            float object2Bottom = object2->y;
            float object2Top = object2->y + object2->height;

            float overlapLeft = object1Right - object2Left;
            float overlapRight = object2Right - object1Left;
            float overlapTop = object2Top - object1Bottom;
            float overlapBottom = object1Top - object2Bottom;

            float horizOverlap = (overlapLeft < overlapRight) ? overlapLeft : overlapRight;
            float vertOverlap = (overlapTop < overlapBottom)  ? overlapTop  : overlapBottom;

            if (vertOverlap < horizOverlap)
            {
                if (overlapTop < overlapBottom)
                {
                    if(object1->id == PLAYER)
                    {
                        Player* player = (Player*)object1;

                        if(object2->id == SPIKES && !player->isAttacking)
                        {
                            player->parent.isDead = TRUE;
							fprintf(logFile, "SPIKES\n");
							fflush(logFile);
                        }

                        player->isGrounded = TRUE;
                        object1->y = object2Top;
                        object1->dy = 0;
                    }
                    else if(!object1->isDead && object1->id == MONKEY)
                    {
                        object1->dy = 0;
                        object1->y = object2Top;
                    }
                }
                else if (overlapBottom < overlapTop)
                {
                    object1->y = object2Bottom - object1->height;
                }
            }
            else 
            {
                if ((overlapLeft < overlapRight && (object1->dx * object1->direction) > 0) 
                    || (overlapRight < overlapLeft &&  (object1->dx * object1->direction) < 0))
                {
                    object1->dx = 0;
                    if(object1->id == MONKEY)
                    {
                        object1->direction *=-1;
                    }
                }
            }
            break;
        }
		case VINES:
		{
			if (object1->id == PLAYER)
			{
				Player* player = (Player*)object1;
				player->touchedVinesThisFrame = TRUE;

				if ((keyState & KEY_UP || keyState & KEY_DOWN) && !player->isClimbing && !player->isAttacking)
				{
					player->isClimbing = TRUE;
					// int desiredPlayerX = object2->x + (object2->width - player->parent.width) / 2;

					// shift = player->parent.x - desiredPlayerX;
					
					// currentBackgroundPositionX -= shift;
					player->parent.dx = 0;
					player->parent.dy = 0;
				}
				if (player->isClimbing)
				{
					player->parent.dx = 0;
					

					if (keyState & KEY_UP)
					{
						player->parent.dy = CLIMBING_SPEED;
					}
					else if (keyState & KEY_DOWN)
					{
						player->parent.dy = -CLIMBING_SPEED;
					}
					else
					{
						player->parent.dy = 0;
					}

					if (keyState & KEY_ACTION)
					{
						player->isClimbing = FALSE;
					}
				}
			}
			break;
		}
	}
}

enum
{
	UP = 57,
	DOWN = 41,
	LEFT = 25,
	RIGHT = 121,
	ACTION = 97
};

//===================================================================================
//FUNCTION - processKeyPress

//PARAMETERS:
//keyCode - The keycode value that has been pressed

//DESCRIPTION:
// This function implements the effects of certain key presses

// RETURN: void
//===================================================================================
void processKeyPress(const int keyCode)
{
   switch (keyCode)
   {
	   case UP:
	   {
		    if(player->isGrounded && !player->isAttacking)
		    {
			   player->isGrounded = FALSE;
			   player->parent.y +=1;
			   player->parent.dy = JUMP_FORCE;
			}
			keyState |= KEY_UP;
			break;
		}
	    case DOWN:
	    {
			if(player->isGrounded == TRUE && !player->isAttacking)
		    {
				player->isCrouching = TRUE;
			}
			keyState |= KEY_DOWN;
			break;
		}
		case LEFT:
		{                 
			player->parent.dx = WALK_SPEED;
			player->parent.direction = -1;
			keyState &= KEY_LEFT;
			break;
		}
		case RIGHT:
		{                   
			player->parent.dx = WALK_SPEED;
			player->parent.direction = 1;
			keyState |= KEY_RIGHT;
			break;
		}
		case ACTION:
		{
			if(player->isAttacking)
		    {				
				if(player->isGrounded)
				{
					player->isGrounded = FALSE;
					player->parent.y +=1;
					player->parent.dy = ATTACK_JUMP_FORCE;
				}
			}
			keyState |= KEY_ACTION;
			break;
		}
		case DOWN + ACTION:
	    {
			player->isAttacking = (!player->isGrounded) * ((player->isAttacking == FALSE) * TRUE + (player->isAttacking)) + (player->isGrounded * player->isAttacking);
			processKeyPress(ACTION * player->isGrounded * player->isAttacking);
			break;
		}
	}         
}


//===================================================================================
//FUNCTION - Input

//PARAMETERS: void
//DESCRIPTION:
// This function checks for user input using OS_BYTE 121

// RETURN:void
//===================================================================================
void Input()
{
	// Inputs keys
	int inputs[] = {UP,DOWN,LEFT,RIGHT,ACTION};
	int output1;
	int output2;
	os_error *e;
	for(int i=0;i<5;i++)
    {
		e = xos_byte((osbyte_op)121,inputs[i]^0x80,(int)NULL ,&output1,&output2);
		if (e != NULL)
		{
			fprintf(logFile, "Failed running os_byte\n"
			"   errnum = %d: message = '%s'\n", e->errnum, e->errmess);
			fflush(logFile);
		}
		else
		{
			if(output1 == 255)
			{
				// Combo input with ACTION
				if(inputs[i] == ACTION)
				{
					e = xos_byte((osbyte_op)121,DOWN^0x80,(int)NULL ,&output1,&output2);
					if (e != NULL)
					{
						fprintf(logFile, "Failed running os_byte\n"
						"   errnum = %d: message = '%s'\n", e->errnum, e->errmess);
						fflush(logFile);
					}
					processKeyPress(inputs[i] + ((output1 == 255) * DOWN));
				}
				else
				{
					processKeyPress(inputs[i]);
				}
			}
			else
			{
				player->isAttacking ^= (inputs[i] == ACTION) * player->isGrounded * (player->isAttacking == TRUE);
			}
		}
	}
}

//===================================================================================
//FUNCTION - updateGroundPositions

//PARAMETERS:
//player - The player
//grounds -  The array of the grounds

//DESCRIPTION:
// This function shifts the ground colliders by a certain amount

// RETURN:void
//===================================================================================
void updateGroundPositions(Player* player, Object** grounds)
{
    for (int i = 0; i < numGrounds; i++)
    {
        grounds[i]->x -= 2 * (player->parent.direction * player->parent.dx) + shift;
    }
}


//===================================================================================
//FUNCTION - shiftObjectsVertical

//PARAMETERS:
//objects - The obejcts to shift
//numObjects -  The size of the object array
//shiftAmount - The amount to move them by

//DESCRIPTION:
// This function shifts the obejcts when the player falls or goes above the screen sizes

// RETURN:void
//===================================================================================
void shiftObjectsVertical(Object** objects, int numObjects, int shiftAmount)
{
    for (int i = 0; i < numObjects; i++)
    {
        objects[i]->y += shiftAmount;
    }
}

//===================================================================================
//FUNCTION - updateEnemies

//PARAMETERS:
//player - The player
//enemies -  Array of enemies
//gameWindow - current game window

//DESCRIPTION:
// This function updates the enemies in the array and does collision checks between the enemies and the player
// as well as the grounds

// RETURN:void
//===================================================================================
void updateEnemies(Player* player, wimp_w* gameWindow)
{
	for (int i = 0; i < NUM_ENEMY_SPAWN_POINTS; i++)
	{
        EnemySpawnPoint* sp = &enemySpawns[i];

        if (sp->isActive && sp->enemy != NULL)
		{
			int spriteNumber;
            Enemy* enemy = sp->enemy;
			if(enemy->parent.id == MONKEY)
			{
				enemy->parent.x += enemy->parent.direction * enemy->parent.dx;
				enemy->parent.y += enemy->parent.dy;
				enemy->parent.dx = ENEMY_WALK_SPEED;
				enemy->parent.dy = enemy->parent.dy - GRAVITY;
				for (int i = 0; i < numGrounds; i++)
				{
					collisionDetection(&enemy->parent, grounds[i]);
				}
			}
			if (enemy->parent.id == BEE)
			{
				if(!enemy->parent.isDead)
				{
					enemy->parent.dx = ENEMY_WALK_SPEED+1;
					enemy->angle += 0.1f;
					enemy->parent.dy = sinf(enemy->angle * 2.0f) * 40.0f;
					enemy->parent.x += enemy->parent.direction * enemy->parent.dx;
					enemy->parent.y = enemy->baseY + enemy->parent.dy;
				}
				else
				{
					enemy->parent.y += enemy->parent.dy;
					enemy->parent.dx = ENEMY_WALK_SPEED;
					enemy->parent.dy = enemy->parent.dy - GRAVITY;
				}
			}

			spriteNumber = getEnemyState(enemy);
			enemy->parent.currentSprite = sprites[spriteNumber];
			
			//Apply paralax effect on the enemies
			enemy->parent.x += - 2 * (player->parent.direction * player->parent.dx);
			collisionDetection(&player->parent, &enemy->parent);
			updateWindow(gameWindow, &enemy->parent);
		}
    }
}

//===================================================================================
//FUNCTION - updatePlayer

//PARAMETERS:
//player - The player
//gameWindow -  current game window which is a variable that is a copy of the window from the block

//DESCRIPTION:
// This function updates the player variables and changes the sprites when the animation timer reaches a certain point

// RETURN:void
//===================================================================================
void updatePlayer(Player* player, wimp_w* gameWindow)
{
	player->parent.y += player->parent.dy;
	player->parent.dx = player->parent.dx <= 0 ? 0 : player->parent.dx - 2.5;
	player->parent.dy = player->isGrounded ? 0 : (player->parent.dy <= -MAX_FALL_VELOCITY ? -MAX_FALL_VELOCITY : player->parent.dy - GRAVITY);
	

	int spriteNumber = getPlayerState(player);
	player->parent.currentSprite = sprites[spriteNumber];
	player->isCrouching = player->isCrouching ? FALSE : player->isCrouching;
	
    updateWindow(gameWindow, &player->parent);
}


//===================================================================================
//FUNCTION - updateGame

//PARAMETERS:
//block - The block for the current application screen

//DESCRIPTION:
// This function implements the main game loop calling function that implement physics and then do the
// rendering for that object

// RETURN:void
//===================================================================================
void updateGame(wimp_block* block)
{
	keyState = 0;
    Input();
    player->isGrounded = FALSE;
    for (int i = 0; i < numGrounds; i++)
    {
        collisionDetection(&player->parent, grounds[i]);
    }
    updateGroundPositions(player, grounds);
	
	// Bounds checking=================================================================================================================
    if (player->parent.y + player->parent.height <= 0 && currentBackgroundYShift != 0)
    {
        player->parent.y += BACKGROUNDYSHIFT;
		// Shift Enemy Spawn Points
		for (int i = 0; i < NUM_ENEMY_SPAWN_POINTS; i++)
		{
			EnemySpawnPoint* sp = &enemySpawns[i];
			sp->y += BACKGROUNDYSHIFT;
			if (sp->isActive) 
			{
				sp->enemy->parent.y += BACKGROUNDYSHIFT;
			}
		}
        shiftObjectsVertical(grounds, numGrounds, BACKGROUNDYSHIFT);
        currentBackgroundYShift -= BACKGROUNDYSHIFT;
    }
	if (player->parent.y >= screenHeight && currentBackgroundYShift != 4)
    {
        player->parent.y -= BACKGROUNDYSHIFT;
		// Shift Enemy Spawn Points
		for (int i = 0; i < NUM_ENEMY_SPAWN_POINTS; i++)
		{
			EnemySpawnPoint* sp = &enemySpawns[i];
			sp->y -= BACKGROUNDYSHIFT;
			if (sp->isActive) 
			{
				sp->enemy->parent.y -= BACKGROUNDYSHIFT;
			}
		}
        shiftObjectsVertical(grounds, numGrounds, -BACKGROUNDYSHIFT);
        currentBackgroundYShift += BACKGROUNDYSHIFT;
    }
	if (player->isClimbing && !player->touchedVinesThisFrame)
	{
		player->isClimbing = FALSE;
	}
	player->touchedVinesThisFrame = FALSE;
	
	//====================================================================================================================================
	for (int i = 0; i < NUM_ENEMY_SPAWN_POINTS; i++) 
	{
		EnemySpawnPoint* sp = &enemySpawns[i];
		if (!sp->isActive && isOnScreen(sp->x, sp->y)) 
		{
			int direction = player->parent.direction == 1 ? -1:1;
			int posX = player->parent.direction == 1 ? (player->parent.x + screenWidth/2) : player->parent.x - (screenWidth/2) ;
			Enemy* temp = malloc(sizeof(Enemy));
			*temp = createEnemy(sp->type, posX,sp->y,direction);
			sp->enemy = temp;
			sp->isActive = 1;
		}
		if (sp->isActive && (sp->enemy == NULL || !isOnScreen(sp->enemy->parent.x, sp->enemy->parent.y))) 
		{
			free(sp->enemy);
			sp->enemy = NULL;
			sp->isActive = 0;
		}
		sp->x += - 2 * (player->parent.direction * player->parent.dx);
	}

	//Null is used for background
    updateWindow(&gameWindow,NULL);

    updateEnemies(player, &gameWindow);
    updatePlayer(player, &gameWindow);
	
	frameCount++;
	os_t currentTime = os_read_monotonic_time();
    if (currentTime - lastFPSTime >= 100)
    {
        fprintf(logFile, "FPS: %d\n", frameCount);
        fflush(logFile);
        frameCount = 0;
        lastFPSTime = currentTime;
    }
	shift = 0;

    setTimer(1, updateGame);
}


//===================================================================================
//FUNCTION - updateWindow

//PARAMETERS:
//window - The game window to draw to
//obj - Object to render

//DESCRIPTION:
// This function sets up the draw to be either the background (null passed) or an object

// RETURN:void
//===================================================================================
void updateWindow(wimp_w* window,Object* obj)
{
	wimp_draw draw;
	draw.w = *window;
	
	if(obj == NULL)
	{
		draw.box.x0 = 0;
		draw.box.y0 = 0 ;
		draw.box.x1 = screenWidth;
		draw.box.y1 = screenHeight;
	}
	else
	{
		draw.box.x0 = obj->x;
		draw.box.y0 = obj->y ;
		draw.box.x1 = draw.box.x0 + obj->width;
		draw.box.y1 = draw.box.y0 + obj->height;
	}
    
	int more;
	
	xwimp_update_window(&draw,&more);
	
	updateRender(&draw, more,obj);
}


//===================================================================================
//FUNCTION - updateRender

//PARAMETERS:
//draw - The draw data
//more - Variable that determins if we have more rectangles to render
//obj - Object to render

//DESCRIPTION:
// This function renders the object passes in the location given draw

// RETURN:void
//===================================================================================
void updateRender(wimp_draw *draw, int more,Object* obj)
{
   while(more)
	{
		int screenX = draw->box.x0 - draw->xscroll;
		int screenY = draw->box.y1 - draw->yscroll;
		os_error *e;
		
		if(obj == NULL)
		{
			currentBackgroundPositionX += 2 * (player->parent.direction * player->parent.dx);
	
			e = xosspriteop_put_sprite_scaled(osspriteop_PTR,
					area,
					(osspriteop_id)state.currentBackground,
					screenX - currentBackgroundPositionX,
					screenY - currentBackgroundYShift,
					osspriteop_GIVEN_WIDE_ENTRIES,
					&Backgroundfactors,
					transTab);
			if (e != NULL)
			{
				fprintf(logFile, "xosspriteop_put_sprite_scaled failed\n"
				"   errnum = %d: message = '%s'\n", e->errnum, e->errmess);
				fflush(logFile);
			}
		}
		else
		{
			e = xosspriteop_put_sprite_scaled(osspriteop_PTR,
					area,
					(osspriteop_id)obj->currentSprite,
					screenX + obj->x,
					screenY + obj->y,
					os_ACTION_OVERWRITE |
					osspriteop_GIVEN_WIDE_ENTRIES | osspriteop_USE_MASK,
					&factors,
					transTab);
					
			if (e != NULL)
			{
				fprintf(logFile, "xosspriteop_put_sprite_scaled failed\n"
				"   errnum = %d: message = '%s'\n", e->errnum, e->errmess);
				fflush(logFile);
			}
		}
		xwimp_get_rectangle(draw, &more);
	}
}

//===================================================================================
//FUNCTION - redrawWindow

//PARAMETERS:
//block - The block for the application screen data

//DESCRIPTION:
// This function sets up the draw area and the starting more value and sets off the render loop

// RETURN:void
//===================================================================================
void redrawWindow(wimp_block *block)
{
    int more;

    xwimp_redraw_window(&block->redraw, &more);

    render(&block->redraw, more);
}

//===================================================================================
//FUNCTION - render

//PARAMETERS:
//draw - The draw data
//more - Variable that determins if we have more rectangles to render

//DESCRIPTION:
// This function calls the SWIs to render the entire scene when force redraws are called or
// at the start of the application

// RETURN:void
//===================================================================================
void render(wimp_draw *draw, int more)
{
   while(more)
   {
		int screenX = draw->box.x0 - draw->xscroll;
		int screenY = draw->box.y1 - draw->yscroll;
		
		//Render background
		os_error *e = xosspriteop_put_sprite_scaled(osspriteop_PTR,
						area,
						(osspriteop_id)state.currentBackground,
						screenX - currentBackgroundPositionX,
						screenY - currentBackgroundYShift,
						os_ACTION_OVERWRITE |
						osspriteop_GIVEN_WIDE_ENTRIES,
						&Backgroundfactors,
						transTab);
						
		for (int i = 0; i < NUM_ENEMY_SPAWN_POINTS; i++)
		{
			EnemySpawnPoint* sp = &enemySpawns[i];

			if (sp->isActive && sp->enemy != NULL)
			{
				e = xosspriteop_put_sprite_scaled(osspriteop_PTR,
					area,
					(osspriteop_id)sp->enemy->parent.currentSprite,
					screenX + sp->enemy->parent.x,
					screenY + sp->enemy->parent.y,
					os_ACTION_OVERWRITE |
					osspriteop_GIVEN_WIDE_ENTRIES | osspriteop_USE_MASK,
					&factors,
					transTab);
			}
		}
		//Render player
		e = xosspriteop_put_sprite_scaled(osspriteop_PTR,
					area,
					(osspriteop_id)player->parent.currentSprite,
					screenX + player->parent.x,
					screenY + player->parent.y,
					os_ACTION_OVERWRITE |
					osspriteop_GIVEN_WIDE_ENTRIES | osspriteop_USE_MASK,
					&factors,
					transTab);
		if (e != NULL)
		{
			fprintf(logFile, "xosspriteop_put_sprite_scaled failed\n"
			"   errnum = %d: message = '%s'\n", e->errnum, e->errmess);
			fflush(logFile);
		}
		xwimp_get_rectangle(draw, &more);
	}
}

os_t timer;

//Callback function pointer
void (*timerCallback)(wimp_block*);

//===================================================================================
//FUNCTION - initialiseTimer

//PARAMETERS: void

//DESCRIPTION:
// This function call the setTimer to set up the timer in main

// RETURN:void
//===================================================================================
void initialiseTimer()
{
   setTimer(16, updateGame);
}

//===================================================================================
//FUNCTION - setTimer

//PARAMETERS:
//cs - Starting wait time
//function Pointer - Points to a function to call once the timer runs out

//DESCRIPTION:
// This function set up the timer and call back function for the timer

// RETURN:void
//===================================================================================
void setTimer(int cs, void (*callback)(wimp_block*))
{
   timer          = os_read_monotonic_time() + cs;
   timerCallback  = callback; 
}

//===================================================================================
//FUNCTION - updateTimer

//PARAMETERS:
//block - The current block for the screen

//DESCRIPTION:
// This function calls the call back function (updateGame) once the time passes the timer

// RETURN:void
//===================================================================================
void updateTimer(wimp_block* block)
{
   if (timer > 0)
   {
      os_t time = os_read_monotonic_time();

      if (time >= timer)
      {
         timer = 0;

         timerCallback(block);
      }
   }
}

