//Store all the objects (player,enemies) create a dynamic array for this
void collisionDetection(Player* player,Object* object)
{
	if(player->parent.x <= object->x + object->width &&
	   player->parent.x + player->parent.width >= object->x &&
	   player->parent.y <= object->y + object->height &&
	   player->parent.y + player->parent.height >= object->y)
	   {
		   collisionResponse(player,object);
	   }
}

void collisionResponse(Player* player,Object* object)
{
	switch(object->id)
	{
		case MONKEY:
		{
			if(player->isAttacking)
			{
				if(!object->isDead)
				{
					object->isDead = TRUE;
					object->dy = 20;
				}
			}
			else
			{
				player->parent.isDead = TRUE;
			}		
			break;
		}
		case GROUND:
		{
			// Assume collision has been detected between player and object

			// Calculate the boundaries
			float playerLeft   = player->parent.x;
			float playerRight  = player->parent.x + player->parent.width;
			float playerBottom = player->parent.y;
			float playerTop    = player->parent.y + player->parent.height;

			float objectLeft   = object->x;
			float objectRight  = object->x + object->width;
			float objectBottom = object->y;
			float objectTop    = object->y + object->height;

			// Compute overlap amounts on each side
			float overlapLeft   = playerRight - objectLeft;
			float overlapRight  = objectRight - playerLeft;
			float overlapTop    = objectTop - playerBottom;   // penetration if landing on top
			float overlapBottom = playerTop - objectBottom;    // penetration if hitting from below

			// Find the minimum overlap distance on each axis.
			float horizOverlap = (overlapLeft < overlapRight) ? overlapLeft : overlapRight;
			float vertOverlap  = (overlapTop < overlapBottom)  ? overlapTop  : overlapBottom;
			

			if (vertOverlap < horizOverlap)
			{

				if (overlapTop < overlapBottom)
				{
					player->parent.y = objectTop;
					player->parent.dy = 0;
					player->isGrounded = TRUE;
				}
				else if (overlapBottom < overlapTop)
				{
					// Player is moving upward (jumping) and hits the object's underside.
					player->parent.y = objectBottom - player->parent.height;
				}
			}
			else 
			{
				// Resolve horizontal collision.
				player->parent.dx *= -1;
				if (overlapLeft < overlapRight)
				{
					// Player collided with the object from the left.
					//player->parent.x = objectLeft - player->parent.width;
				}
				else 
				{
					// Collision from the right side.
					//player->parent.x = objectRight;
				}
			}
			break;
		}
    }
}

void processKeyPress(const int keyCode)
{
   switch (keyCode)
   {
	   case UP:
	   {
		   //Makes an error for now will look at this later
		    if(player->isGrounded && !player->isAttacking)
		    {
			   player->isGrounded = FALSE;
			   player->parent.y +=1;
			   player->parent.dy = 40;
			}
			break;
		}
	    case DOWN:
	    {
		   /*
			if(player->isGrounded == TRUE)
		    {
				player.isCrouching = TRUE;
			}
			*/
			
			break;
		}
		case LEFT:
		{                 
			player->parent.dx = 20;
			player->parent.direction = -1;
			break;
		}
		case RIGHT:
		{                   
			player->parent.dx = 20;
			player->parent.direction = 1;
			break;
		}
		case ACTION:
		{
			
			if(player->isAttacking)
		    {				
				if(player->isGrounded)
				{
					player->isGrounded = FALSE;
					player->parent.y +=1;
					player->parent.dy = 55;
				}
			}
			break;
		}
		case DOWN + ACTION:
	    {
			player->isAttacking = (!player->isGrounded) * ((player->isAttacking == FALSE) * TRUE + (player->isAttacking)) + (player->isGrounded * player->isAttacking);
			processKeyPress(ACTION * player->isGrounded * player->isAttacking);
			break;
		}
	}         
}
void Input()
{
	// Inputs keys
	int inputs[] = {UP,DOWN,LEFT,RIGHT,ACTION};
	int output1;
	int output2;
	os_error *e;
	for(int i=0;i<5;i++)
    {
		e = xos_byte((osbyte_op)121,inputs[i]^0x80,(int)NULL ,&output1,&output2);
		if (e != NULL)
		{
			fprintf(logFile, "Failed running os_byte\n"
			"   errnum = %d: message = '%s'\n", e->errnum, e->errmess);
			fflush(logFile);
		}
		else
		{
			if(output1 == 255)
			{
				// Combo input with ACTION
				if(inputs[i] == ACTION)
				{
					e = xos_byte((osbyte_op)121,DOWN^0x80,(int)NULL ,&output1,&output2);
					if (e != NULL)
					{
						fprintf(logFile, "Failed running os_byte\n"
						"   errnum = %d: message = '%s'\n", e->errnum, e->errmess);
						fflush(logFile);
					}
					processKeyPress(inputs[i] + ((output1 == 255) * DOWN));
				}
				else
				{
					processKeyPress(inputs[i]);
				}
			}
			else
			{
				player->isAttacking ^= (inputs[i] == ACTION) * player->isGrounded * (player->isAttacking == TRUE);
			}
		}
	}
}
//Game Logic======================================================================
void updateGame(wimp_block* block)
{
   Input();
   player->isGrounded = FALSE;
   for(int i=0;i<numGrounds;i++)
   {
	   collisionDetection(player,grounds[i]);
   }
   for(int i=0;i<numGrounds;i++)
   {
		grounds[i]->x -= 2 * (player->parent.direction * player->parent.dx);
   }
   
   //Redraw the background
   redrawBackground(&gameWindow);
   
   int spriteNumber = 0;   
   //Update the enenmies================================================================================================
   for(int i=0;i<numEnemies;i++)
   {
		enemies[i]->parent.x += (enemies[i]->parent.direction * enemies[i]->parent.dx) - 2 * (player->parent.direction * player->parent.dx);
		
		enemies[i]->parent.y += enemies[i]->parent.dy;
		
		spriteNumber = getEnemyState(enemies[i]);
		enemies[i]->parent.currentSprite = sprites[spriteNumber];
		enemies[i]->parent.dx = 10;
		
		enemies[i]->parent.dy = enemies[i]->parent.isDead ? enemies[i]->parent.dy - 2.5 : 0;
		
		collisionDetection(player,&(enemies[i]->parent));
		
		updateWindow(&gameWindow,enemies[i]->parent);
   }
  // Update the Player ================================================================================================
  
   player->parent.y += player->parent.dy;
   spriteNumber = getPlayerState(player);
   player->parent.currentSprite = sprites[spriteNumber];
   player->parent.dx = player->parent.dx<=0?0:player->parent.dx-2.5;
   player->parent.dy = player->isGrounded == FALSE ?  player->parent.dy <= -25 ? -25 : player->parent.dy-3.5 : 0;
   
   updateWindow(&gameWindow,player->parent);
   
   setTimer(4, updateGame);
}

void updateWindow(wimp_w* window,Object obj)
{
	wimp_draw draw;
	draw.w = *window;
	
    draw.box.x0 = obj.x;
    draw.box.y0 = obj.y ;
    draw.box.x1 = draw.box.x0 + obj.width;
    draw.box.y1 = draw.box.y0 + obj.height;
		
	int more;
	
	xwimp_update_window(&draw,&more);
	
	updateRender(&draw, more,obj);
}

void updateRender(wimp_draw *draw, int more,Object obj)
{
   while(more)
	{
		int screenX = draw->box.x0 - draw->xscroll;
		int screenY = draw->box.y1 - draw->yscroll;
		os_error *e;
		
		e = xosspriteop_put_sprite_scaled(osspriteop_PTR,
					area,
					(osspriteop_id)obj.currentSprite,
					screenX + obj.x,
					screenY + obj.y,
					os_ACTION_OVERWRITE |
					osspriteop_GIVEN_WIDE_ENTRIES | osspriteop_USE_MASK,
					&factors,
					transTab);
					
		if (e != NULL)
		{
			fprintf(logFile, "xosspriteop_put_sprite_scaled failed\n"
			"   errnum = %d: message = '%s'\n", e->errnum, e->errmess);
			fflush(logFile);
		}
		xwimp_get_rectangle(draw, &more);
	}
}

void redrawWindow(wimp_block *block)
{
    int more;

    xwimp_redraw_window(&block->redraw, &more);

    render(&block->redraw, more);
}
void render(wimp_draw *draw, int more)
{
   while(more)
   {
		int screenX = draw->box.x0 - draw->xscroll;
		int screenY = draw->box.y1 - draw->yscroll;
		
		os_error *e = xosspriteop_put_sprite_scaled(osspriteop_PTR,
						area,
						(osspriteop_id)state.currentBackground,
						screenX - backgroundPositionX,
						screenY - backgroundYShift,
						os_ACTION_OVERWRITE |
						osspriteop_GIVEN_WIDE_ENTRIES,
						&Backgroundfactors,
						transTab);
		//Render the enemies
		for(int i = 0;i<numEnemies;i++)
		{
			e = xosspriteop_put_sprite_scaled(osspriteop_PTR,
					area,
					(osspriteop_id)enemies[i]->parent.currentSprite,
					screenX + enemies[i]->parent.x,
					screenY + enemies[i]->parent.y,
					os_ACTION_OVERWRITE |
					osspriteop_GIVEN_WIDE_ENTRIES | osspriteop_USE_MASK,
					&factors,
					transTab);
		}
		//Render the player
		e = xosspriteop_put_sprite_scaled(osspriteop_PTR,
					area,
					(osspriteop_id)player->parent.currentSprite,
					screenX + player->parent.x,
					screenY + player->parent.y,
					os_ACTION_OVERWRITE |
					osspriteop_GIVEN_WIDE_ENTRIES | osspriteop_USE_MASK,
					&factors,
					transTab);
		if (e != NULL)
		{
			fprintf(logFile, "xosspriteop_put_sprite_scaled failed\n"
			"   errnum = %d: message = '%s'\n", e->errnum, e->errmess);
			fflush(logFile);
		}
		xwimp_get_rectangle(draw, &more);
	}
}

void* redrawBackground(wimp_w* window)
{
	wimp_draw draw;
	draw.w = *window;
	
	//Set the box to match the screen size
    draw.box.x0 = 0;
    draw.box.y0 = 0;
    draw.box.x1 = 2400;
    draw.box.y1 = 1600;
		
	int more;
	xwimp_update_window(&draw,&more);
	
	backgroundRender(&draw, more);
	return NULL;
}

void backgroundRender(wimp_draw *draw, int more)
{
	int screenX = draw->box.x0 - draw->xscroll;
	int screenY = draw->box.y1 - draw->yscroll;
	
	backgroundPositionX += 2 * (player->parent.direction * player->parent.dx);
	
	os_error *e = xosspriteop_put_sprite_scaled(osspriteop_PTR,
					area,
					(osspriteop_id)state.currentBackground,
					screenX - backgroundPositionX,
					screenY - backgroundYShift,
					osspriteop_GIVEN_WIDE_ENTRIES,
					&Backgroundfactors,
					transTab);
	if (e != NULL)
	{
		fprintf(logFile, "xosspriteop_put_sprite_scaled failed\n"
		"   errnum = %d: message = '%s'\n", e->errnum, e->errmess);
		fflush(logFile);
	}
}
//Timer===========================================================================
os_t timer;

//Callback function pointer
void (*timerCallback)(wimp_block*);

void initialiseTimer()
{
   setTimer(16, updateGame);
}
//Set the timer values
void setTimer(int cs, void (*callback)(wimp_block*))
{
   timer          = os_read_monotonic_time() + cs;
   timerCallback  = callback; 
}

void updateTimer(wimp_block* block)
{
   if (timer > 0)
   {
      os_t time = os_read_monotonic_time();

      if (time >= timer)
      {
         timer = 0;

         timerCallback(block);
      }
   }
}
