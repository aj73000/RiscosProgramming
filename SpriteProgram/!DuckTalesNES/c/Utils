#include "Utils.h"

void buildWindow(wimp_window ** window,int numIcons,int windowWidth,int wiondowHeight)
{
  (*window) = malloc(sizeof(wimp_(*window)) + sizeof(wimp_icon) * numIcons);
  (*window)->visible.x0 = 0;
  (*window)->visible.y0 = 0;
  (*window)->visible.x1 = windowWidth;
  (*window)->visible.y1 = wiondowHeight;
  
  (*window)->xscroll = 0;
  (*window)->yscroll = 0;
  (*window)->next = wimp_TOP;
  (*window)->flags = wimp_WINDOW_MOVEABLE | wimp_WINDOW_BACK_ICON | wimp_WINDOW_CLOSE_ICON |
		  wimp_WINDOW_TITLE_ICON //|wimp_WINDOW_HSCROLL |
		  /*wimp_WINDOW_VSCROLL */ | wimp_WINDOW_TOGGLE_ICON |
		  wimp_WINDOW_SIZE_ICON | wimp_WINDOW_NEW_FORMAT | wimp_WINDOW_BOUNDED |
		  wimp_WINDOW_HAS_FOCUS | wimp_WINDOW_HOT_KEYS;

  (*window)->title_fg = wimp_COLOUR_BLACK;
  (*window)->title_bg = wimp_COLOUR_LIGHT_GREY;
  (*window)->work_fg = wimp_COLOUR_WHITE;
  (*window)->work_bg = wimp_COLOUR_LIGHT_GREY; 
  (*window)->scroll_outer = wimp_COLOUR_MID_LIGHT_GREY;
  (*window)->scroll_inner = wimp_COLOUR_VERY_LIGHT_GREY;
  (*window)->extent.x0 = 0;
  (*window)->extent.y0 = 0;
  (*window)->extent.x1 = windowWidth;
  (*window)->extent.y1 = wiondowHeight;
  
  (*window)->title_flags = wimp_ICON_TEXT 
						| wimp_ICON_HCENTRED 
						|wimp_ICON_VCENTRED;
  (*window)->work_flags = wimp_BUTTON_WRITABLE << wimp_ICON_BUTTON_TYPE_SHIFT;
  (*window)->sprite_area = 0;
  (*window)->xmin = 0;
  (*window)->ymin = 0;
  strncpy((*window)->title_data.text,"DuckTalesNES version",12);
  (*window)->icon_count = numIcons;
}

void loadWindowIntoBlock(wimp_window **window,wimp_block *block)
{
  block->open.w = wimp_create_window(*window);
  block->open.visible = (*window)->visible;
  block->open.xscroll = (*window)->xscroll;
  block->open.yscroll = (*window)->yscroll;
  block->open.next = (*window)->next;
}