extern osspriteop_area *area;

extern os_factors factors;

extern osspriteop_trans_tab *transTab;

void loadSpriteFile(const char *filename,const char *imageNames[],const int imagesSize);

//State Machine==============================================
int getPlayerState(Player* player);

int getEnemyState(Enemy* enemy);

void collisionDetection(Object* player,Object* object);

void collisionResponse(Object* object1, Object* object2);

void updateRender(Object* obj);

void redrawWindow(wimp_block *block);
void render(wimp_draw *draw, int more);

void blitBackground(wimp_w* window);
void backgroundBufferRender(wimp_draw *draw);

