#include "Utils.h"
//Game Logic===============================================
typedef enum objectTypes
{
	GROUND = 2,
	PLAYER = 4,
	SPIDER = 6,
	MONKEY = 10,
	VINES = 16,
	SPIKES = 32
}objectTypes;

typedef struct
{
	osspriteop_header *currentBackground;
}gameState;

typedef struct
{                                       
   osspriteop_header *currentSprite;
   int x, y;   // coordinates of the sprite
   int width,height;
   int frame;
   osbool isDead;
   objectTypes id;
   //-1 left, 1 right
   int direction;
   int dx, dy;
}Object;

typedef struct
{
	Object parent;
	osbool isGrounded;
	osbool isAttacking;
	osbool isCrouching;
	
}Player;

typedef struct
{
	Object parent;
}Enemy;

Player* player;

Player createPlayer(int x, int y);

Enemy createEnemy(objectTypes type,int x, int y);

Object createObject(int x1,int x2,int y1,int y2,objectTypes type);

void updateGame(wimp_block* block);

extern wimp_w gameWindow;

extern gameState state;

//Timer====================================================
void initialiseTimer();

void setTimer(int cs, void (*callback)(wimp_block*));

void updateTimer();

//Sprites===================================================
extern osspriteop_area *area;

extern os_factors factors;

extern osspriteop_trans_tab *transTab;

void loadSpriteFile(const char *filename,const char *imageNames[],const int imagesSize);

//State Machine==============================================
int getPlayerState(Player* player);

int getEnemyState(Enemy* enemy);

void collisionDetection(Object* player,Object* object);

void collisionResponse(Object* object1, Object* object2);

void updateWindow(wimp_w* window,Object* obj);
void updateRender(wimp_draw *draw, int more,Object* obj);

void redrawWindow(wimp_block *block);
void render(wimp_draw *draw, int more);