#include "Utils.h"
#include <stdint.h>

//Game Logic===============================================
typedef enum objectTypes
{
	GROUND = 2,
	PLAYER = 4,
	SPIDER = 6,
	MONKEY = 13,
	BEE    = 16,
	VINES  = 32,
	SPIKES = 64
}objectTypes;

enum 
{
    KEY_UP     = 1 << 0,
    KEY_DOWN   = 1 << 1,
    KEY_LEFT   = 1 << 2,
    KEY_RIGHT  = 1 << 3,
    KEY_ACTION = 1 << 4
};

uint8_t keyState = 0;

typedef struct
{
	osspriteop_header *currentBackground;
}gameState;

typedef struct
{                                       
   osspriteop_header *currentSprite;
   int x, y;   // coordinates of the sprite
   int width,height;
   int frame;
   osbool isDead;
   objectTypes id;
   //-1 left, 1 right
   int direction;
   float dx, dy;
}Object;

typedef struct
{
	Object parent;
	osbool isGrounded;
	osbool isAttacking;
	osbool isCrouching;
	osbool isClimbing;
	osbool touchedVinesThisFrame;
	int health;
	osbool beenHit;
}Player;

typedef struct
{
	Object parent;
	//For bee
	int baseY;
	float angle;
}Enemy;

typedef struct 
{
    int x, y;
    osbool isActive;
	objectTypes type;
    Enemy* enemy;
} EnemySpawnPoint;

Player* player;

Player createPlayer(int x, int y);

Enemy createEnemy(objectTypes type,int x, int y,int direction);

Object createObject(int x1,int x2,int y1,int y2,objectTypes type);

void updateGame(wimp_block* block);

extern wimp_w gameWindow;

extern gameState state;

//Timer====================================================
void initialiseTimer();

void setTimer(int cs, void (*callback)(wimp_block*));

void updateTimer();

