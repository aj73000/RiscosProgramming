			osspriteop_flip_about_yaxis(osspriteop_PTR,objects[i]->area,(osspriteop_id)objects[i]->sprites[spriteNumber].sprite);
			objects[i]->sprites[spriteNumber].direction = objects[i]->direction;
		}
		// If error then 0
		objects[i]->currentSprite = spriteNumber == -1 ? objects[i]->sprites[0].sprite : objects[i]->sprites[spriteNumber].sprite;
		
		objects[i]->dx = objects[i]->dx<=0?0:objects[i]->dx-2.5;
		
		objects[i]->dy = objects[i]->isGrounded == false ?  objects[i]->dy <= -20 ? -20 : objects[i]->dy-2.5 : 0;
		
		wimp_force_redraw(gameWindow,objects[i]->renderBox.minX,objects[i]->renderBox.minY,
		objects[i]->renderBox.maxX,objects[i]->renderBox.maxY);
	}
   setTimer(4, updateGame);
}
//Timer===========================================================================
os_t timer;

//Callback function pointer
void (*timerCallback)(wimp_block*);

void initialiseTimer()
{
   setTimer(16, updateGame);
}
//Set the timer values
void setTimer(int cs, void (*callback)(wimp_block*))
{
   timer          = os_read_monotonic_time() + cs;
   timerCallback  = callback; 
}

void updateTimer(wimp_block* block)
{
   if (timer > 0)
   {
      os_t time = os_read_monotonic_time();

      if (time >= timer)
      {
         timer = 0;

         timerCallback(block);
      }
   }
}
