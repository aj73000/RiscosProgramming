void updateGame(wimp_block* block)
{                                                                
   //state->frame++;
   
	
   //if (state->frame%4 == 0)
   //{
      //state->sprite = state->sprite == invader1 ? invader2 : invader1; 
   //}

   //if ((state->x >> 8) >= 640 - 72)
   //{
    //  state->dx = -(2 << 8);
   //}                        
   //else if ((state->x >> 8) < 0)
   //{
   //   state->dx = +(2 << 8);
   //}  

   //if ((state->y >> 8) >= 512 - 68)
   //{
   //   state->dy = -(2 << 8);
   //}                        
   //else if ((state->y >> 8) < 0)
   //{
   //   state->dy = +(2 << 8);
   //} 

   //state->x += state->dx;
   //state->y += state->dy;
   
   for(int i=0;i<sizeof(objects)/sizeof(objects[0]);i++)
   {
		objects[i]->x += (objects[i]->direction * objects[i]->dx);
		objects[i]->y += objects[i]->dy;
		
		objects[i]->renderBox.minX = objects[i]->x - objects[i]->width;
		objects[i]->renderBox.minY = objects[i]->y - objects[i]->height;
		objects[i]->renderBox.maxX = objects[i]->x + objects[i]->width;
