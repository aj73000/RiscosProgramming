//=================================================================================
osbool update(wimp_event_no event,wimp_block* block)
{
    switch(event)
    {
		case wimp_MOUSE_CLICK:
		{
			fprintf(logFile, "MOUSE_CLICK received.\n"); 
			fflush(logFile);
			break;
		}
		case wimp_KEY_PRESSED:
		{
			fprintf(logFile, "KEY_PRESSED received (%#x).\n", block->key.c);
			fflush(logFile);

			processKeyPress(block->key.c);
			break;
		}
		case wimp_REDRAW_WINDOW_REQUEST:
		{
			fprintf(logFile, "REDRAW_WINDOW_REQUEST received.\n"); 
			fflush(logFile);
			
			wimp_draw draw;
			draw.w = block->redraw.w;
			draw.box = block->redraw.box;
			
			// Theses are the position of the bottom left of the screen
			
			int screenX = (*block).open.visible.x0;
			int screenY = (*block).open.visible.y0;
			
			int more;
			xwimp_redraw_window(&draw, &more);
			while (more)
			{
				os_error *e =  NULL;
				for(int i=0;i<sizeof(objects)/sizeof(objects[0]);i++)
				{
					//Check if the sprite is on the screen first
					if(objects[i]->redraw)
					{
						if(objects[i]->x >= (draw.clip.x0 - screenX-objects[i]->width) && objects[i]->x <= (draw.clip.x1 - screenX))
						{
							if(objects[i]->y >= (draw.clip.y0-screenY) && objects[i]->y <= (draw.clip.y1 - screenY))
							{
								e = xosspriteop_put_sprite_scaled(osspriteop_PTR,
									objects[i]->area,
									(osspriteop_id)objects[i]->currentSprite,
									screenX + objects[i]->x,
									screenY + objects[i]->y,
									os_ACTION_OVERWRITE |
									osspriteop_GIVEN_WIDE_ENTRIES | 0x8,
									&factors,
									objects[i]->transTab);
									
								objects[i]->redraw = false;
							}
						}
					}
				}
				//os_error *e = xosspriteop_put_sprite_scaled(osspriteop_PTR,
				//		area,
				//		(osspriteop_id)duckIdle,
				//		screenX + 100,
				//		screenY + 100,
				//		os_ACTION_OVERWRITE |
				//		osspriteop_GIVEN_WIDE_ENTRIES | 0x8,
				//		&factors,
				//		transTab);

				if (e != NULL)
				{
					fprintf(logFile, "xosspriteop_put_sprite_scaled failed\n"
					"   errnum = %d: message = '%s'\n", e->errnum, e->errmess);
					fflush(logFile);
				}
				xwimp_get_rectangle(&draw, &more);
			}
			break;
		}
		case wimp_OPEN_WINDOW_REQUEST:
		{
			fprintf(logFile, "OPEN_WINDOW_REQUEST received.\n");                
			fflush(logFile);
			wimp_open_window(&block->open);
			break;
		}
		case wimp_CLOSE_WINDOW_REQUEST:
		{
			fprintf(logFile, "CLOSE_WINDOW_REQUEST received.\n");                                         
			fflush(logFile);
			wimp_close_window(block->close.w);
			return TRUE;
		}
		case wimp_USER_MESSAGE:
		{
			break;
		}
		case wimp_USER_MESSAGE_RECORDED:
		{
			fprintf(logFile, "USER_MESSAGE_RECORDED received.\n");                            
			fflush(logFile);
			if(block->message.action == message_QUIT)
			{
				fprintf(logFile, "QUIT message received.\n");                                          
				fflush(logFile);
				return TRUE;
			}
			break;
		}
	}
	return FALSE;
}

int main()
{
    wimp_event_no event;
    wimp_block block;
    osbool quit = FALSE;
    wimp_window *window;
    int numIcons = 0;

    wimp_initialise(wimp_VERSION_RO3,"DuckTales",NULL,NULL);
	updateModeInfo();

    buildWindow(&window,numIcons);
    loadWindowIntoBlock(&window,&block);
	gameWindow = block.open.w;
	
	// Initialize log file
    logFile = fopen("<DuckTalesNES$Dir>.logFile", "w");
    if (logFile == NULL)
    { 
        perror("Error opening log file");
        return EXIT_FAILURE;
    }
    fprintf(logFile, "Starting Application\n");

	//Testing multiple ducks
	
	Object* temp = malloc(sizeof(Object));
	*temp = createObject(PLAYER,100,0);
	objects[0] = temp;
	
	//temp = malloc(sizeof(Object));
	//*temp = createObject(MONKEY,(100),250);
	//objects[1] = temp;
	
	initialiseTimer();
		
	fprintf(logFile,"Opening window...\n");
	fflush(logFile);
	
    os_error *err = xwimp_open_window(&block.open);
    if (err != NULL)
    {
        fprintf(logFile, "msg = '%s'\n", err->errmess);
        fflush(logFile);
    }
	
    while(!quit)
    {
		event = wimp_poll(0,&block,NULL);
		if (event == wimp_NULL_REASON_CODE)
		{
			updateTimer(&block);
		}
		else
		{
			quit = update(event,&block);	
		}		
    }
	
	for(int i=0;i<sizeof(objects)/sizeof(objects[0]);i++)
		free(objects[i]);
	
    free(window);
    wimp_close_down(0);
	free(area);
    fclose(logFile);
    return 0;
}
