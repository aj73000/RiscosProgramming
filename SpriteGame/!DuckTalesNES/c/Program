osspriteop_area *area;

osspriteop_header *duckIdle;

os_factors factors;

osspriteop_trans_tab *transTab;

void loadSpriteFile(const char *filename,Object* obj,const char *imageNames[],const int imagesSize)
{
   int size;

   bits type;
   
   fprintf(logFile, "loading sprites...\n"); 
   fflush(logFile);

   fileswitch_object_type objType;
   
   os_error *e = xosfile_read_stamped_no_path(filename, &objType, NULL, NULL, &size, NULL, &type);
   
   if (e != NULL)
   {
      fprintf(logFile, "Failed Getting Size\n"
         "   errnum = %d: message = '%s'\n", e->errnum, e->errmess);
      fflush(logFile);
   }
   
   fprintf(logFile, "sprite file size = %d\n", size);
   fflush(logFile);

   size += sizeof(int);
   
   osspriteop_area *area = malloc(size);

   area->size  = size;
   area->first = 16;

	//Load sprite file
	e = xosspriteop_load_sprite_file(osspriteop_USER_AREA, area, filename);
	
   if (e != NULL)
   {
	  free(area);
      fprintf(logFile, "Failed Loading SpriteFile\n"
         "   errnum = %d: message = '%s'\n", e->errnum, e->errmess);
      fflush(logFile);
   }
   
   
   // This may cause unknown behaviour may need to change
   Sprite sprites[imagesSize];
   
   for(int i = 0; i < imagesSize ; i++)
   {
	   // determine more efficient sprite pointer ids                               
   
		e = xosspriteop_select_sprite(osspriteop_USER_AREA, 
								area, 
                               (osspriteop_id)imageNames[i],
                               &(sprites[i].sprite));
							   
		sprites[i].direction = -1;
		if (e != NULL)
		{
			free(area);
			fprintf(logFile, "selecting %s failed\n"
				"   errnum = %d: message = '%s'\n",imageNames[i], e->errnum, e->errmess);
			fflush(logFile);
		}
   }
   
   // set up factors and translation table
   //Sprite factors so width height etc
   factors.xmul = 2<<(modeInfo.info.xEigFactor-1);
   factors.ymul = 1<<(modeInfo.info.yEigFactor);
   factors.xdiv = 1;
   factors.ydiv = 1;

   e = xcolourtrans_generate_table_for_sprite(area,  
                                       (osspriteop_id)imageNames[0],
                                       (os_mode)-1,   
                                       (os_palette*)-1,    
                                       NULL,
                                       colourtrans_CURRENT_IF_ABSENT |
                                       colourtrans_RETURN_WIDE_ENTRIES,
                                       NULL,
                                       NULL,
                                       &size);
   if (e != NULL)
   {
      fprintf(logFile, "xcolourtrans_generate_table #1 failed\n"
         "   errnum = %d: message = '%s'\n", e->errnum, e->errmess);
      fflush(logFile);
   }

   fprintf(logFile, "colourtrans table size = %d\n", size);
   fflush(logFile);
   
   transTab = malloc(size);

   e = xcolourtrans_generate_table_for_sprite(area, 
                                    (osspriteop_id)imageNames[0],
                                    (os_mode)-1,   
                                    (os_palette*)-1,   
                                    transTab,
                                    colourtrans_CURRENT_IF_ABSENT |
                                    colourtrans_RETURN_WIDE_ENTRIES,
                                    NULL,
                                    NULL,
                                    &size);
	
   if (e != NULL)
   {
      fprintf(logFile, "xcolourtrans_generate_table #2 failed\n"
         "   errnum = %d: message = '%s'\n", e->errnum, e->errmess);
      fflush(logFile);
   }
   // all done
   fprintf(logFile, "finished loading sprites\n");
   fflush(logFile);
   
   // Could be some issues here
   //Set all the obj values
   obj->area = area;
   obj->transTab = transTab;
   obj->currentSprite = sprites[0].sprite;
   memcpy(obj->sprites, sprites, imagesSize * sizeof(sprites[0]));
   free(sprites);
}


//Maybe change design. Not sure if this is a good idea
int getState(Object* obj)
{
	enum checks
	{
		GROUNDED = 2,
		MOVING = 4
	};
	
	switch(obj->id)
	{
		//Player state
		case PLAYER:
		{
			int stateNumber = 0;
			// 00000001
			stateNumber = obj->isGrounded == true ? stateNumber + GROUNDED : stateNumber;
			stateNumber = obj->dx > 0 ? stateNumber + MOVING : stateNumber;
			
			switch(stateNumber)
			{
				case GROUNDED:
					obj->frame = 0;
					return 0;
				case GROUNDED + MOVING:
				{
					int result = 1 + (obj->frame % 16)/4;
					obj->frame++;
					return result;
				}
				//Change to match the jumping animation
				case MOVING:
				default:
					return -1;
			}
			break;
		}
		case SPIDER:
			return obj->frame % 2;
		break;
	}	
	return -1;
}

