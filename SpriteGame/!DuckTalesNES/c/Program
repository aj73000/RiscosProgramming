//Objects==========================================================================
Player createPlayer(int x, int y)
{
	Player player;
	RenderBox box;
	player.parent.x = x;
	player.parent.y = y;
	player.parent.dx = 0;
	player.parent.dy = 0;
	player.parent.id = PLAYER;
	player.parent.frame = 0;
	player.isGrounded = TRUE;
	
	player.parent.spriteNumber = 0;
	//-1 is left, 1 is right
	player.parent.direction = -1;
	player.parent.currentSprite = sprites[0].sprite;
	player.parent.width = 150;
	player.parent.height = 150;
	box.minX = x;
	box.minY = y;
	box.maxX = x+player.parent.width;
	box.maxY = y+player.parent.height;
	player.parent.renderBox = box;
	
	return player;
}
Enemy createEnemy(objectTypes type,int x, int y)
{
	Enemy enemy;
	RenderBox box;
	enemy.parent.x = x;
	enemy.parent.y = y;
	enemy.parent.dx = 0;
	enemy.parent.dy = 0;
	enemy.parent.id = type;
	enemy.parent.frame = 0;
	enemy.parent.spriteNumber = 0;	
	//-1 is left, 1 is right
	enemy.parent.direction = -1;
	enemy.parent.currentSprite = sprites[type].sprite;
	enemy.parent.width = 150;
	enemy.parent.height = 150;
	box.minX = x;
	box.minY = y;
	box.maxX = x+enemy.parent.width;
	box.maxY = y+enemy.parent.height;
	enemy.parent.renderBox = box;
	
	return enemy;
}
//Sprites==========================================================================
void loadSpriteFile(const char *filename,const char *imageNames[],const int imagesSize)
{
   int size;

   bits type;
   
   fprintf(logFile, "loading sprites...\n"); 
   fflush(logFile);

   fileswitch_object_type objType;
   
   os_error *e = xosfile_read_stamped_no_path(filename, &objType, NULL, NULL, &size, NULL, &type);
   
   if (e != NULL)
   {
      fprintf(logFile, "Failed Getting Size\n"
         "   errnum = %d: message = '%s'\n", e->errnum, e->errmess);
      fflush(logFile);
   }
   fprintf(logFile, "sprite file size = %d\n", size);
   fflush(logFile);

   size += sizeof(int);
   
   area = malloc(size);

   area->size  = size;
   area->first = 16;

	//Load sprite file
	e = xosspriteop_load_sprite_file(osspriteop_USER_AREA, area, filename);
	
   if (e != NULL)
   {
	  free(area);
      fprintf(logFile, "Failed Loading SpriteFile\n"
         "   errnum = %d: message = '%s'\n", e->errnum, e->errmess);
      fflush(logFile);
   }
   for(int i = 0; i < imagesSize ; i++)
   {
	   // determine more efficient sprite pointer ids                               
		e = xosspriteop_select_sprite(osspriteop_USER_AREA, 
								area, 
                               (osspriteop_id)imageNames[i],
                               &(sprites[i].sprite));
							   
		sprites[i].direction = -1;
		if (e != NULL)
		{
			free(area);
			fprintf(logFile, "selecting %s failed\n"
				"   errnum = %d: message = '%s'\n",imageNames[i], e->errnum, e->errmess);
			fflush(logFile);
		}
   }
   
   // set up factors and translation table
   //Sprite factors so width height etc
   factors.xmul = 2<<(modeInfo.info.xEigFactor-1);
   factors.ymul = 1<<(modeInfo.info.yEigFactor);
   factors.xdiv = 1;
   factors.ydiv = 1;

   e = xcolourtrans_generate_table_for_sprite(area,  
                                       (osspriteop_id)imageNames[0],
                                       (os_mode)-1,   
                                       (os_palette*)-1,    
                                       NULL,
                                       colourtrans_CURRENT_IF_ABSENT |
                                       colourtrans_RETURN_WIDE_ENTRIES,
                                       NULL,
                                       NULL,
                                       &size);
   if (e != NULL)
   {
      fprintf(logFile, "xcolourtrans_generate_table #1 failed\n"
         "   errnum = %d: message = '%s'\n", e->errnum, e->errmess);
      fflush(logFile);
   }

   fprintf(logFile, "colourtrans table size = %d\n", size);
   fflush(logFile);
   
   transTab = malloc(size);

   e = xcolourtrans_generate_table_for_sprite(area, 
                                    (osspriteop_id)imageNames[0],
                                    (os_mode)-1,   
                                    (os_palette*)-1,   
                                    transTab,
                                    colourtrans_CURRENT_IF_ABSENT |
                                    colourtrans_RETURN_WIDE_ENTRIES,
                                    NULL,
                                    NULL,
                                    &size);
   if (e != NULL)
   {
      fprintf(logFile, "xcolourtrans_generate_table #2 failed\n"
         "   errnum = %d: message = '%s'\n", e->errnum, e->errmess);
      fflush(logFile);
   }
   // all done
   fprintf(logFile, "finished loading sprites\n");
   fflush(logFile);
}

//Maybe change design. Not sure if this is a good idea
int getPlayerState(Player* player)
{
	enum checks
	{
		GROUNDED = 2,
		MOVING = 4
	};
	
	int stateNumber;
	// 00000001
	stateNumber = player->isGrounded == TRUE ? GROUNDED : 0;
	stateNumber = player->parent.dx > 0 ? stateNumber + MOVING : stateNumber;
	
	switch(stateNumber)
	{
		case GROUNDED:
		{
			player->parent.frame = 0;
			return 0;
		}
		case GROUNDED + MOVING:
		{
			int result = 1 + (player->parent.frame % 16)/4;
			player->parent.frame++;
			return result;
		}
		default:
		return 5;
	}
	return 0;
}

int getEnemyState(Enemy* enemy)
{
	switch (enemy->parent.id)
	{
		case MONKEY:
		{
			int result = MONKEY + (enemy->parent.frame % 8)/4;
			enemy->parent.frame++;
			return result;
		}	
	}
	return enemy->parent.id;
}
//=================================================================================
osbool update(wimp_event_no event,wimp_block* block)
{
    switch(event)
    {
		case wimp_REDRAW_WINDOW_REQUEST:
		{
			fprintf(logFile, "REDRAW_WINDOW_REQUEST received.\n"); 
			fflush(logFile);
			
			wimp_draw draw;
			draw.w = block->redraw.w;
			draw.box = block->redraw.box;
			
			// Theses are the position of the bottom left of the screen
			int more;
			xwimp_redraw_window(&draw, &more);
			while (more)
			{
				int screenX = draw.box.x0 - draw.xscroll;
				int screenY = draw.box.y1 - draw.yscroll;
				os_error *e =  NULL;
				
				//Render the enemies
				for(int i = 0;i<sizeof(enemies)/sizeof(enemies[0]);i++)
				{
					if(enemies[i]->parent.direction != sprites[enemies[i]->parent.spriteNumber].direction)
					{
						osspriteop_flip_about_yaxis(osspriteop_PTR,area,(osspriteop_id)sprites[enemies[i]->parent.spriteNumber].sprite);
						sprites[enemies[i]->parent.spriteNumber].direction = enemies[i]->parent.direction;
					}
					e = xosspriteop_put_sprite_scaled(osspriteop_PTR,
							area,
							(osspriteop_id)enemies[i]->parent.currentSprite,
							screenX + enemies[i]->parent.x,
							screenY + enemies[i]->parent.y,
							os_ACTION_OVERWRITE |
							osspriteop_GIVEN_WIDE_ENTRIES | 0x8,
							&factors,
							transTab);
					fprintf(logFile, "Render Enemy[%i]\n",i);
					fflush(logFile);
				}
				if(player->parent.direction != sprites[player->parent.spriteNumber].direction)
				{
					osspriteop_flip_about_yaxis(osspriteop_PTR,area,(osspriteop_id)sprites[player->parent.spriteNumber].sprite);
					sprites[player->parent.spriteNumber].direction = player->parent.direction;
				}
				//Render the player
				e = xosspriteop_put_sprite_scaled(osspriteop_PTR,
							area,
							(osspriteop_id)player->parent.currentSprite,
							screenX + player->parent.x,
							screenY + player->parent.y,
							os_ACTION_OVERWRITE |
							osspriteop_GIVEN_WIDE_ENTRIES | 0x8,
							&factors,
							transTab);					
				fprintf(logFile, "Render Player\n");
				fflush(logFile);
				if (e != NULL)
				{
					fprintf(logFile, "xosspriteop_put_sprite_scaled failed\n"
					"   errnum = %d: message = '%s'\n", e->errnum, e->errmess);
					fflush(logFile);
				}		
				xwimp_get_rectangle(&draw, &more);
			}
			break;
		}
		case wimp_OPEN_WINDOW_REQUEST:
		{
			fprintf(logFile, "OPEN_WINDOW_REQUEST received.\n");                
			fflush(logFile);
			wimp_open_window(&block->open);
			break;
		}
		case wimp_CLOSE_WINDOW_REQUEST:
		{
			fprintf(logFile, "CLOSE_WINDOW_REQUEST received.\n");                                         
			fflush(logFile);
			wimp_close_window(block->close.w);
			return TRUE;
		}
		case wimp_USER_MESSAGE:
		{
			break;
		}
		case wimp_USER_MESSAGE_RECORDED:
		{
			fprintf(logFile, "USER_MESSAGE_RECORDED received.\n");                            
			fflush(logFile);
			if(block->message.action == message_QUIT)
			{
				fprintf(logFile, "QUIT message received.\n");                                          
				fflush(logFile);
				return TRUE;
			}
			break;
		}
	}
	return FALSE;
}

int main()
{
    wimp_event_no event;
    wimp_block block;
    osbool quit = FALSE;
    wimp_window *window;
    int numIcons = 0;

    wimp_initialise(wimp_VERSION_RO3,"DuckTales",NULL,NULL);
	updateModeInfo();

    buildWindow(&window,numIcons);
    loadWindowIntoBlock(&window,&block);
	gameWindow = block.open.w;
	
	// Initialize log file
    logFile = fopen("<DuckTalesNES$Dir>.logFile", "w");
    if (logFile == NULL)
    { 
        perror("Error opening log file");
        return EXIT_FAILURE;
    }
    fprintf(logFile, "Starting Application\n");

	const char *images[9] = {"idleleft","walkingleft0","walkingleft1","walkingleft2","walkingleft3","jumpleft",
	"monkey0","monkey1","monkeydead"};
	
	const int size = sizeof(images)/sizeof(images[0]);
	loadSpriteFile("<DuckTalesNES$Dir>.Images.States",images,size);	
	
	player = malloc(sizeof(Player));
	*player = createPlayer(100,0);
	
	Enemy* temp = malloc(sizeof(Enemy));
	*temp = createEnemy(MONKEY,250,0);
	enemies[0] = temp;
	
	initialiseTimer();
		
	fprintf(logFile,"Opening window...\n");
	fflush(logFile);
	
    os_error *err = xwimp_open_window(&block.open);
    if (err != NULL)
    {
        fprintf(logFile, "msg = '%s'\n", err->errmess);
        fflush(logFile);
    }
	
    while(!quit)
    {
		event = wimp_poll(0,&block,NULL);
		if (event == wimp_NULL_REASON_CODE)
		{
			updateTimer(&block);
		}
		else
		{
			quit = update(event,&block);
		}		
    }
	
	for(int i=0;i<sizeof(enemies)/sizeof(enemies[0]);i++)
		free(enemies[i]);
	
    free(window);
    wimp_close_down(0);
	free(player);
	free(area);
    fclose(logFile);
    return 0;
}