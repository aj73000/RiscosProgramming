void processKeyPress(int keyCode)
{
   switch (keyCode)
   {
      case 65:
      {                 
        player->parent.dx = 20;
		player->parent.direction = -1;
        break;
      }
      case 50:
      {                   
		player->parent.dx = 20;
		player->parent.direction = 1;
        break;
      }
      case 33:
      {
		//Makes an error for now will look at this later
		if(player->isGrounded == TRUE)
		{
			player->isGrounded = FALSE;
			player->parent.dy = 20;
		}
        break;
      }
      case 81:
      {
         //state.dy = -2 << 8;

         break;
      }
   }         
}
//Game Logic======================================================================
void updateGame(wimp_block* block)
{                                                   
   int output1;
   int output2;
   os_error *e = xos_byte((osbyte_op)121,33,(int)NULL ,&output1,&output2);
   
   fprintf(logFile,"%i\n",output1);
   fflush(logFile);
   
   if (e != NULL)
   {
      fprintf(logFile, "Failed running os_byte\n"
         "   errnum = %d: message = '%s'\n", e->errnum, e->errmess);
      fflush(logFile);
   }
   else
   {
	   //255 is no keypress
	   if(output1 != 255)
	   {
		   processKeyPress(output1);
		   if(output1 == 33)
		   {
			   os_error *e = xos_byte((osbyte_op)121,34,(int)NULL ,&output1,&output2);
			   if(output1 != 255)
			   {
				   processKeyPress(output1);
			   }
		   }
	   }
   }
   
   int spriteNumber = 0;
   //Update the enenmies================================================================================================
   for(int i=0;i<sizeof(enemies)/sizeof(enemies[0]);i++)
   {
		enemies[i]->parent.x += (enemies[i]->parent.direction * enemies[i]->parent.dx);
		enemies[i]->parent.y += enemies[i]->parent.dy;
		enemies[i]->parent.renderBox.minX = enemies[i]->parent.x - enemies[i]->parent.width;
		enemies[i]->parent.renderBox.minY = enemies[i]->parent.y - enemies[i]->parent.height;
		enemies[i]->parent.renderBox.maxX = enemies[i]->parent.x + enemies[i]->parent.width;
		enemies[i]->parent.renderBox.maxY = enemies[i]->parent.y + enemies[i]->parent.height;
		
		spriteNumber = getEnemyState(enemies[i]);
		enemies[i]->parent.spriteNumber = spriteNumber;
		enemies[i]->parent.currentSprite = sprites[spriteNumber].sprite;
		enemies[i]->parent.dx = enemies[i]->parent.dx<=0?0:enemies[i]->parent.dx-2.5;
		
		//wimp_force_redraw(gameWindow,enemies[i]->parent.renderBox.minX,enemies[i]->parent.renderBox.minY,
		//enemies[i]->parent.renderBox.maxX,enemies[i]->parent.renderBox.maxY);
   }
   
  // Update the Player ================================================================================================
   player->parent.x += (player->parent.direction * player->parent.dx);
   player->parent.y += player->parent.dy;
   if(player->parent.y < 0)
   {
	   player->parent.y = 0;
	   player->isGrounded = TRUE;
	   player->parent.dy = 0;
   }
   player->parent.renderBox.minX = player->parent.x - player->parent.width;
   player->parent.renderBox.minY = player->parent.y - player->parent.height;
   player->parent.renderBox.maxX = player->parent.x + player->parent.width;
   player->parent.renderBox.maxY = player->parent.y + player->parent.height;
   
   spriteNumber = getPlayerState(player);
   player->parent.spriteNumber = spriteNumber;
   player->parent.currentSprite = sprites[spriteNumber].sprite;
   player->parent.dx = player->parent.dx<=0?0:player->parent.dx-2.5;
   player->parent.dy = player->isGrounded == FALSE ?  player->parent.dy <= -20 ? -20 : player->parent.dy-2.5 : 0;
   
   //wimp_force_redraw(gameWindow,player->parent.renderBox.minX,player->parent.renderBox.minY,
   //player->parent.renderBox.maxX,player->parent.renderBox.maxY);
   
   //Dirty the screen
    wimp_force_redraw(gameWindow,0,0,2400,1600);
   //==================================================================================================================
   setTimer(4, updateGame);
}
//Timer===========================================================================
os_t timer;

//Callback function pointer
void (*timerCallback)(wimp_block*);

void initialiseTimer()
{
   setTimer(16, updateGame);
}
//Set the timer values
void setTimer(int cs, void (*callback)(wimp_block*))
{
   timer          = os_read_monotonic_time() + cs;
   timerCallback  = callback; 
}

void updateTimer(wimp_block* block)
{
   if (timer > 0)
   {
      os_t time = os_read_monotonic_time();

      if (time >= timer)
      {
         timer = 0;

         timerCallback(block);
      }
   }
}
