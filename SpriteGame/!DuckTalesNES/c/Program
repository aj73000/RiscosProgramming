//Objects==========================================================================
Object createObject(objectTypes type, int x, int y)
{
	Object obj;
	RenderBox box;
	obj.x = x;
	obj.y = y;
	obj.dx = 0;
	obj.dy = 0;
	obj.id = type;
	obj.frame = 0;
	obj.redraw = true;
	obj.isGrounded = true;
	
	//-1 is left, 1 is right
	obj.direction = -1;
	
	switch (type)
	{
		case PLAYER:
		{
			const char *images[5] = {"idleleft","walkingleft0","walkingleft1","walkingleft2","walkingleft3"};
			const int size = sizeof(images)/sizeof(images[0]);
			obj.width = 150;obj.height = 150;
			box.minX = x;
			box.minY = y;
			box.maxX = x+obj.width;
			box.maxY = y+obj.height;
			loadSpriteFile("<DuckTalesNES$Dir>.Images.ScroogeMcDuck.Sprites.States",&obj,images,size);
			break;
		}
		case SPIDER:
		{
			break;
		}
		case MONKEY:
		{
			const char *images[3] = {"monkey0","monkey1","monkeydead"};
			const int size = sizeof(images)/sizeof(images[0]);
			obj.width = 150;obj.height = 150;
			box.minX = x;
			box.minY = y;
			box.maxX = x+obj.width;
			box.maxY = y+obj.height;
			loadSpriteFile("<DuckTalesNES$Dir>.Images.Enemies.Monkey.Sprites.Monkey",&obj,images,size);
			break;
		}
		default: { fprintf(stderr, "Unknown object type\n"); break; }
	}
	obj.renderBox = box;
	
	return obj;
}
